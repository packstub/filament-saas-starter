APP_NAME="SaaS Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `sync` sends queued e-mails (verification, password reset) during the request, so they arrive
# without a queue worker. In production use `database` or `redis` and run `php artisan queue:work`.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (Laravel Cashier). Leave empty to run without billing: the Billing
# page then explains what to set. Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=
STRIPE_SECRET=
# From `stripe listen --forward-to <APP_URL>/stripe/webhook` in local development,
# or from the webhook endpoint that `php artisan cashier:webhook` creates in production.
STRIPE_WEBHOOK_SECRET=
# The recurring price IDs (price_...) of each paid plan in config/billing.php. A plan
# without a yearly price is sold monthly only.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
CASHIER_CURRENCY=usd
# Days of free trial on a workspace's first subscription; 0 turns trials off.
BILLING_TRIAL_DAYS=14

# Sign in with Google and GitHub (config/services.php): each turns on once both of its
# values are set. Callback URLs: <APP_URL>/auth/google/callback, <APP_URL>/auth/github/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The public site (config/site.php): the home page's headline and meta description,
# and the company and contact address on the Terms and Privacy pages.
# SITE_TAGLINE=
# SITE_DESCRIPTION=
# SITE_COMPANY=
# SITE_CONTACT_EMAIL=
# SITE_TWITTER=
# false once the Terms and Privacy pages hold your own text.
# SITE_LEGAL_PLACEHOLDERS=true

VITE_APP_NAME="${APP_NAME}"
